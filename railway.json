{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm install --frozen-lockfile && pnpm worker:build"
  },
  "deploy": {
    "startCommand": "pnpm worker:once",
    "cronSchedule": "0 */2 * * *",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
