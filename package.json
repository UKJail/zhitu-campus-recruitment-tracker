{
  "name": "zhitutracker",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "overrides": {
    "@xmldom/xmldom": "0.8.15"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local scripts/start-local-dev.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync:offerstar": "node scripts/sync-workbuddy-offerstar.mjs",
    "sync:career-portals": "node scripts/sync-workbuddy-career-portals.mjs",
    "worker:build": "tsc -p worker/tsconfig.json",
    "worker:start": "node dist-worker/index.js",
    "worker:once": "node dist-worker/index.js --once",
    "worker:probe": "node dist-worker/probe.js",
    "worker:api-probe": "node dist-worker/api-probe.js",
    "worker:tencent-campus-probe": "node dist-worker/tencent-campus-probe.js",
    "worker:verify": "node dist-worker/verify.js",
    "worker:repair-runs": "node dist-worker/repair-runs.js",
    "worker:verify-inbound": "node dist-worker/verify-inbound.js",
    "audit:mail-isolation": "node scripts/audit-mail-isolation.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "clsx": "2.1.1",
    "jszip": "3.10.1",
    "lucide-react": "1.31.0",
    "mammoth": "1.12.1",
    "next": "16.3.0",
    "pdf-parse": "2.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "6.19.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.2",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "~9.39.1",
    "eslint-config-next": "16.3.0",
    "jsdom": "30.0.1",
    "typescript": "~5.9.3",
    "vitest": "4.1.10"
  }
}
